# Application Configuration
APP_NAME=CyberSentinel
APP_VERSION=1.0.0
APP_ENV=development

# ENVIRONMENT drives production hardening.
#   development -> docs on, warnings tolerated
#   production  -> startup refuses DEBUG=true, wildcard CORS or placeholder
#                  secrets, and /docs, /redoc, /openapi.json are not mounted
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./cybersentinel.db

# Schema management. Leave false to keep the existing create_all behaviour for
# the SQLite development database. Set true to run Alembic migrations at startup.
USE_ALEMBIC=false

# JWT Authentication
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank in development and a random ephemeral key is generated instead
# (sessions reset whenever the process restarts).
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini AI (backend only - never put these values in frontend env files)
# Leave unset to disable AI features entirely; the app falls back to
# deterministic rule-based explanations.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=20

# Scanner Configuration
# Hard wall-clock budget for a single scan. A scan that exceeds it is cancelled
# and marked FAILED. Must exceed your slowest real target.
SCAN_TIMEOUT_SECONDS=300

# Maximum scans that may be pending/running at once, across all users.
# Enforced server-side from the database. Set 0 to disallow scans entirely.
MAX_CONCURRENT_SCANS=5

# Per-user scan quota over a rolling window. Set 0 to disallow scans entirely.
SCAN_RATE_LIMIT_PER_HOUR=20
SCAN_RATE_LIMIT_WINDOW_SECONDS=3600

# Login throttling. After LOGIN_MAX_FAILED_ATTEMPTS failures the delay doubles
# per extra failure, so a typo never locks anyone out but brute force crawls.
# COUNTED DOWN: failures older than LOGIN_FAILURE_WINDOW_SECONDS are discarded,
# so the throttle can never become a permanent lockout.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_BASE_DELAY_SECONDS=5
LOGIN_MAX_DELAY_SECONDS=900
LOGIN_FAILURE_WINDOW_SECONDS=900

# RAG Configuration
CHROMA_PERSIST_DIR=./chroma_db
RAG_COLLECTION_NAME=cybersecurity_knowledge

# Report Configuration
REPORT_OUTPUT_DIR=./reports

# CORS
# List explicit origins. "*" is refused at startup because credentialed
# requests are allowed. Never combine a wildcard with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mount /docs, /redoc and /openapi.json.
# Leave unset to follow ENVIRONMENT (on in development, off in production).
#ENABLE_API_DOCS=

# Only enable behind a proxy you control. When true, X-Forwarded-For and
# X-Real-IP are used for login throttling, which clients can otherwise spoof.
TRUST_PROXY_HEADERS=false

# Logging
LOG_LEVEL=INFO
